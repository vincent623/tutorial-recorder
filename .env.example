# 教程自动录制器 - AI 冒烟测试配置模板
#
# 使用方法：复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）
#
#   cp .env.example .env
#
# 也可以完全绕过 .env，直接用 PW_* 环境变量运行：
#
#   PW_PROVIDER_PRESET=openRouter \
#   PW_API_BASE_URL=https://openrouter.ai/api/v1 \
#   PW_MODEL_ID=google/gemini-2.5-flash \
#   PW_API_KEY=你的密钥 \
#   npm run smoke:ai
#
# 以下三种键名等价，任选其一；优先识别 TUTORIAL_RECORDER_* 形式
TUTORIAL_RECORDER_API_BASE_URL=https://openrouter.ai/api/v1
TUTORIAL_RECORDER_API_KEY=
TUTORIAL_RECORDER_MODEL_ID=google/gemini-2.5-flash
